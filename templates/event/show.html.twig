{% extends 'base.html.twig' %}

{% block title %}{{ event.titre }}{% endblock %}

{% block body %}
    {% set labels = {
        'concert': 'Concert',
        'conference': 'Conférence',
        'atelier': 'Atelier',
        'sport': 'Sport'
    } %}
    {% set inscrit = app.user and app.user in event.inscrits %}

    <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

    <article class="cat-{{ event.categorie }}">
        <header class="detail-hero"{% if event.image %} style="background-image: url('{{ asset('images/' ~ event.image) }}')"{% endif %}>
            <div class="detail-hero-content">
                <span class="badge">{{ labels[event.categorie]|default(event.categorie) }}</span>
                <h1>{{ event.titre }}</h1>
                <p>{{ event.date|date('d/m/Y') }} · {{ event.date|date('H\\hi') }}</p>
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                <p>{{ event.informations|nl2br }}</p>
            </section>

            <aside class="card booking">
                {% if event.isComplet %}
                    <p class="places"><span class="badge badge-full">Complet</span></p>
                {% else %}
                    <p class="places"><strong>{{ event.placesRestantes }}</strong> places restantes sur {{ event.places }}</p>
                {% endif %}

                <div class="progress">
                    <span style="width: {{ ((event.places - event.placesRestantes) / event.places * 100)|round }}%"></span>
                </div>

                {% if not app.user %}
                    <a class="btn btn-block" href="{{ path('app_login') }}">Connectez-vous pour vous inscrire</a>

                {% elseif inscrit %}
                    <p class="muted">Vous êtes inscrit à cet événement.</p>
                    <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('unregister' ~ event.id) }}">
                        <button type="submit" class="btn btn-secondary btn-block">Se désinscrire</button>
                    </form>

                {% elseif event.isComplet %}
                    <button class="btn btn-block" disabled>Complet</button>

                {% else %}
                    <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('register' ~ event.id) }}">
                        <button type="submit" class="btn btn-block">S'inscrire</button>
                    </form>
                {% endif %}
            </aside>
        </div>
    </article>
{% endblock %}