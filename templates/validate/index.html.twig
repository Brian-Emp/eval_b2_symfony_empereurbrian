{% extends 'base.html.twig' %}

{% block title %}Validation des événements{% endblock %}

{% block body %}
    {% set labels = {
        'concert': 'Concert',
        'conference': 'Conférence',
        'atelier': 'Atelier',
        'sport': 'Sport'
    } %}

    <div class="section-head">
        <div>
            <h1>Événements à valider</h1>
            <p class="muted">{{ events|length }} événement(s) en attente de validation.</p>
        </div>
    </div>

    {% if events is not empty %}
        <div class="card table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Événement</th>
                        <th>Date</th>
                        <th>Catégorie</th>
                        <th>Places</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                        <tr>
                            <td><a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.titre }}</a></td>
                            <td>{{ event.date|date('d/m/Y H\\hi') }}</td>
                            <td><span class="badge cat-{{ event.categorie }}">{{ labels[event.categorie]|default(event.categorie) }}</span></td>
                            <td>{{ event.places }}</td>
                            <td><span class="badge badge-pending">Non validé</span></td>
                            <td>
                                <form method="post" action="{{ path('app_validate_event', {id: event.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ event.id) }}">
                                    <button type="submit" class="btn btn-small btn-success">Valider</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="empty">Aucun événement en attente</p>
    {% endif %}
{% endblock %}